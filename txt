// ORDENAÇÃO BOLHA (BUBBLE SORT)
// --------------------------------------------------

// void ordenarBolha(int vetor[], int tamanho): cria uma função chamada ordenarBolha.
// Ela recebe o vetor e seu tamanho para realizar a ordenação.

// int i, j, temp: cria três variáveis inteiras.
// i: controla as passagens.
// j: percorre o vetor.
// temp: guarda temporariamente um número durante uma troca.

// int houveTroca: cria uma variável que informa se aconteceu alguma troca.

// for (i = 0; i < tamanho - 1; i++): controla as passagens da ordenação.
// i = 0: começa na primeira passagem.
// i < tamanho - 1: limita a quantidade de passagens.
// i++: avança para a próxima passagem.

// houveTroca = 0: indica que inicialmente nenhuma troca aconteceu.

// for (j = 0; j < tamanho - 1 - i; j++): percorre o vetor comparando os números vizinhos.
// j = 0: começa na primeira posição.
// j < tamanho - 1 - i: percorre as posições que ainda precisam ser verificadas.
// j++: avança uma posição.

// if (vetor[j] > vetor[j + 1]): verifica se o número atual é maior que o próximo.
// Se for maior, os números precisam trocar de posição.

// temp = vetor[j]: guarda o número atual temporariamente.

// vetor[j] = vetor[j + 1]: coloca o próximo número na posição atual.

// vetor[j + 1] = temp: coloca o número guardado em temp na posição seguinte.

// houveTroca = 1: informa que aconteceu uma troca.

// if (houveTroca == 0): verifica se nenhuma troca aconteceu durante a passagem.

// break: interrompe a repetição porque o vetor já está ordenado.

// --------------------------------------------------
// ORDENAÇÃO POR SELEÇÃO (SELECTION SORT)
// --------------------------------------------------

// void ordenarSelecao(int vetor[], int tamanho): cria uma função chamada ordenarSelecao.
// Ela recebe o vetor e seu tamanho para realizar a ordenação.

// int i, j, menor, temp: cria as variáveis utilizadas na ordenação.
// i: controla a posição atual.
// j: percorre as posições seguintes.
// menor: guarda o índice do menor número encontrado.
// temp: guarda temporariamente um número durante a troca.

// for (i = 0; i < tamanho - 1; i++): percorre as posições do vetor.
// i = 0: começa na primeira posição.
// i < tamanho - 1: controla as passagens.
// i++: avança para a próxima posição.

// menor = i: considera inicialmente que a posição atual possui o menor número.

// for (j = i + 1; j < tamanho; j++): começa a procurar o menor número nas posições seguintes.

// j = i + 1: começa a comparação na posição seguinte à atual.

// j < tamanho: continua enquanto existirem posições para verificar.

// j++: avança para a próxima posição.

// if (vetor[j] < vetor[menor]): compara o número atual com o menor encontrado até agora.

// menor = j: atualiza a posição do menor número encontrado.

// temp = vetor[i]: guarda o número da posição atual.

// vetor[i] = vetor[menor]: coloca o menor número na posição atual.

// vetor[menor] = temp: coloca o número guardado na posição onde estava o menor.

// --------------------------------------------------
// ORDENAÇÃO POR INSERÇÃO (INSERTION SORT)
// --------------------------------------------------

// void ordenarInsercao(int vetor[], int tamanho): cria uma função chamada ordenarInsercao.
// Ela recebe o vetor e seu tamanho para realizar a ordenação.

// int i, j, chave: cria as variáveis utilizadas na ordenação.
// i: percorre o vetor.
// j: percorre as posições anteriores.
// chave: guarda o número que será inserido na posição correta.

// for (i = 1; i < tamanho; i++): começa na segunda posição do vetor.
// O primeiro elemento já é considerado ordenado.

// chave = vetor[i]: guarda o número atual para inseri-lo na posição correta.

// j = i - 1: começa a comparação pela posição anterior à chave.

// while (j >= 0 && vetor[j] > chave): verifica se ainda existem posições anteriores
// e se o número encontrado é maior que a chave.
// j >= 0: verifica se não ultrapassamos o início do vetor.
// vetor[j] > chave: verifica se o número anterior é maior que a chave.
// &&: significa E, ou seja, as duas condições precisam ser verdadeiras.

// vetor[j + 1] = vetor[j]: desloca o número maior uma posição para a direita.

// j--: volta uma posição para continuar procurando o lugar correto.

// vetor[j + 1] = chave: coloca a chave na posição correta.

